set(compiler "@CMAKE_CXX_COMPILER@")
set(flags [==[@CMAKE_CXX_FLAGS@]==])
separate_arguments(flags NATIVE_COMMAND "${flags}")
set(includes [==[$<TARGET_PROPERTY:aniparse-tests,INCLUDE_DIRECTORIES>]==])
list(FILTER includes EXCLUDE REGEX "^$")
list(REMOVE_DUPLICATES includes)
if("@CMAKE_CXX_COMPILER_ID@" STREQUAL "MSVC")
    list(APPEND flags /std:c++20 /Zs /EHsc)
else()
    list(APPEND flags -std=c++20 -fsyntax-only)
    if(NOT "@CMAKE_OSX_SYSROOT@" STREQUAL "")
        list(APPEND flags -isysroot "@CMAKE_OSX_SYSROOT@")
    elseif(NOT "@CMAKE_SYSROOT@" STREQUAL "")
        list(APPEND flags "--sysroot=@CMAKE_SYSROOT@")
    endif()
    if(NOT "@CMAKE_CXX_COMPILER_TARGET@" STREQUAL "")
        list(APPEND flags "--target=@CMAKE_CXX_COMPILER_TARGET@")
    endif()
endif()
foreach(directory IN LISTS includes)
    list(APPEND flags "-I${directory}")
endforeach()
foreach(invalid_case RANGE 0 3)
    foreach(use_boost RANGE 0 1)
        execute_process(COMMAND "${compiler}" ${flags}
            "-DJSON_INVALID_CASE=${invalid_case}" "-DJSON_USE_BOOST=${use_boost}"
            "@CMAKE_CURRENT_SOURCE_DIR@/compile-fail/JsonDecode.cpp"
            RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE errors)
        file(WRITE "@CMAKE_CURRENT_BINARY_DIR@/json-compile-$<CONFIG>-${invalid_case}-${use_boost}.log"
            "${output}${errors}")
        if(invalid_case EQUAL 0)
            if(NOT status STREQUAL "0")
                message(FATAL_ERROR "Positive conversion control failed: ${output}${errors}")
            endif()
        else()
            if(status STREQUAL "0")
                message(FATAL_ERROR "Invalid conversion ${invalid_case} accepted (Boost=${use_boost})")
            endif()
            if(invalid_case EQUAL 1)
                set(expected "several described members with the same name")
            elseif(invalid_case EQUAL 2)
                set(expected "value_to_impl|No suitable tag_invoke")
            else()
                set(expected "insert")
            endif()
            if(NOT "${output}${errors}" MATCHES "${expected}")
                message(FATAL_ERROR "Unexpected compilation failure: ${output}${errors}")
            endif()
        endif()
    endforeach()
endforeach()
